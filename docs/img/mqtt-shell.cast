{"version": 2, "width": 80, "height": 31, "timestamp": 1789698600, "command": "mqtt-shell-demo"}
[0.42, "o", "\u001b[1mthesada MQTT shell\u001b[0m  -  remote CLI over TLS\r\n"]
[0.54, "o", "broker, TLS and auth flags omitted below   device thesada/node\r\n"]
[0.66, "o", "\r\n"]
[1.56, "o", "\u001b[1;36m$\u001b[0m mosquitto_sub -t thesada/node/cli_response -C 1 &\r\n"]
[1.68, "o", "\r\n"]
[2.58, "o", "\u001b[1;36m$\u001b[0m mosquitto_pub -t thesada/node/cli/chip.info -m ''\r\n"]
[2.7, "o", "cli_response  cmd=chip.info  ok=true\r\n"]
[2.82, "o", "  chip: ESP32-S3  rev=0  cores=2\r\n"]
[2.94, "o", "  device_id: thesada-demo-node\r\n"]
[3.06, "o", "  pubkey: <redacted>\r\n"]
[3.18, "o", "  factory-provisioned: true\r\n"]
[3.3, "o", "  flash: 8388608 bytes (8.00 MB)\r\n"]
[3.42, "o", "  psram: 8368131 bytes free / 8385879 bytes total\r\n"]
[3.54, "o", "  cpu freq: 240 MHz\r\n"]
[3.66, "o", "\r\n"]
[4.56, "o", "\u001b[1;36m$\u001b[0m mosquitto_pub -t thesada/node/cli/heap -m ''\r\n"]
[4.68, "o", "cli_response  cmd=heap  ok=true\r\n"]
[4.8, "o", "  Free: 147084 B  Min: 134620 B  Max alloc: 129012 B\r\n"]
[4.92, "o", "  PSRAM: free 8368131 B  size 8385879 B  min 8351835 B  max alloc 8257524 B\r\n"]
[5.04, "o", "\r\n"]
[5.94, "o", "\u001b[1;36m$\u001b[0m mosquitto_pub -t thesada/node/cli/fs.ls -m ''\r\n"]
[6.06, "o", "cli_response  cmd=fs.ls  ok=true\r\n"]
[6.18, "o", "      2961  /ca.crt\r\n"]
[6.3, "o", "      2320  /config.json\r\n"]
[6.42, "o", "    [DIR]  /scripts/\r\n"]
[6.54, "o", "\r\n"]
[7.44, "o", "\u001b[1;36m$\u001b[0m mosquitto_pub -t thesada/node/cli/config.get -m 'device.name'\r\n"]
[7.56, "o", "cli_response  cmd=config.get  ok=true\r\n"]
[7.68, "o", "  \"thesada-node\"\r\n"]
[7.8, "o", "\r\n"]
