#!/bin/sh
# thesada-fw pre-push: run local CI, then remind about the HIL bench.
#
# make ci is the same host and board work CI gates on. THESADA_CI_SKIP=1
# skips that and still prints the bench reminder when pushing main.
# The reminder never blocks. THESADA_HIL_SKIP=1 silences it.
# Override the suggested bench command: THESADA_HIL_CMD="..." git push

set -eu

if [ -z "${THESADA_CI_SKIP:-}" ]; then
  cd "$(git rev-parse --show-toplevel)"
  make ci
fi

[ -n "${THESADA_HIL_SKIP:-}" ] && exit 0

push_main=0
while read -r _local _localsha remoteref _remotesha; do
  case "$remoteref" in
    refs/heads/main) push_main=1 ;;
  esac
done

if [ "$push_main" -eq 1 ]; then
  cmd="${THESADA_HIL_CMD:-hil-flash-and-smoke all}"
  printf '\n[HIL] pushing main - run the HIL bench smoke on the rack first:\n' >&2
  printf '      %s\n' "$cmd" >&2
  printf '      (reminder only; THESADA_HIL_SKIP=1 to silence)\n\n' >&2
fi
exit 0
