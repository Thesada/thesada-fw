#!/bin/sh
# thesada-fw commit-msg guard: keep private values out of commit subjects.
#
# Thin wrapper around scripts/check-commit-msg.sh. Refuses the commit when
# the message contains internal hostnames or RFC1918 IPs; publish copies
# subjects into the public GitHub release body.
#
# Bypass:
#     MSG_OK=1 git commit ...

set -eu

repo_root="$(git rev-parse --show-toplevel)"

exec "$repo_root/scripts/check-commit-msg.sh" "$1"
